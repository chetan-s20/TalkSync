# NOTE: HF cache is on C: drive where models already exist.
#      Do NOT set HF_HOME to D: — it would force re-downloads.
# HF_HOME is intentionally left unset to use default C:\Users\Chetan Sharma\.cache\huggingface

# Sarvam AI Configurations (Hindi Support)
# NOTE: These keys were previously committed and may be compromised.
#      Rotate them at provider consoles if you haven't already.
tts_sarvam_api_key=
tts_sarvam_voice=shubh
tts_sarvam_lang=hi-IN

# DeepL translation
translation_deepl_api_key=

# Audio device overrides (optional)
# Input: Microphone (Realtek HD Audio Mic input) - index 35 (wired headphone mic, in=2)
audio_input_device_id=35
# Output: Headphones 1 (Realtek HD Audio 2nd output with HAP) - index 36 (out=2)
audio_output_device_id=36

# VAD Settings
vad_threshold=0.45

# STT Engine Selection
stt_model=openai #Systran/faster-distil-whisper-large-v3 
stt_beam_size=5
stt_vad_filter=false
stt_no_speech_threshold=0.75
stt_compression_ratio_threshold=2.0
stt_log_prob_threshold=-1.0
stt_temperature=0.0
stt_best_of=5

# ─── OpenAI STT (gpt-4o-transcribe) ───────────────────────────────────────────
# Set your OpenAI API key here.
# Then set stt_engine=openai to switch from local Whisper to cloud transcription.
# Set stt_engine=local (or leave unset) to keep local Whisper (offline, faster).
openai_api_key=
openai_stt_model=gpt-4o-transcribe
# openai_proxy_url=http://192.168.0.1:8090   # uncomment if behind corporate proxy
talksync_stt_engine=groq
stt_refinement=true

# Groq API Keys (Primary Mic & Dedicated Loopback)
groq_api_key=
groq_loopback_api_key=
groq_stt_model=whisper-large-v3-turbo

